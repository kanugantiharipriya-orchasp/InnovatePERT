                <reportElement x="305" y="2" width="55" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{normalCost}]]></textFieldExpression>
