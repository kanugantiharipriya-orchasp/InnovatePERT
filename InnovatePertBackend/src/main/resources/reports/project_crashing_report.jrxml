                <textFieldExpression><![CDATA[$F{normalTime}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="205" y="2" width="45" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{crashTime}]]></textFieldExpression>
