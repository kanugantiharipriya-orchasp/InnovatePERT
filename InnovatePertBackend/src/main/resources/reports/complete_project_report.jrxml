                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{totalExpectedDuration} != null ? String.format("%.2f", $P{totalExpectedDuration}) : "0.00") + " Days"]]></textFieldExpression>
            </textField>

            <!-- Card 3: Schedule Variance -->
            <rectangle radius="4">
