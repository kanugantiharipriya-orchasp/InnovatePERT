            </textField>

            <!-- EXECUTIVE DEFINITIONS CARD -->
            <rectangle radius="4">
                <reportElement x="0" y="228" width="535" height="95" backcolor="#FFFFFF" uuid="5f6a7b8c-9d0e-1f2a-3b4c-5d6e7f8a9b0c"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
