                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="15" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($P{totalVariance} != null && $P{totalVariance} > 0.0) 
    ? String.format("%.2f", $P{totalVariance}) 
